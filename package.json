{
  "name": "9router-hono",
  "version": "0.1.0",
  "description": "Ultra-fast headless Hono proxy engine for 9Router",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "9router-hono": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/server.js",
    "dev": "node scripts/build.js && node dist/server.js",
    "start:bun": "bun dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "chalk": "^5.4.1",
    "confbox": "^0.2.4",
    "hono": "^4.7.4",
    "jose": "^6.0.8",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "socks-proxy-agent": "^8.0.5",
    "sql.js": "^1.14.1",
    "undici": "^7.19.2",
    "uuid": "^11.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "keywords": [
    "9router",
    "hono",
    "llm",
    "proxy",
    "ai",
    "gateway",
    "claude-code",
    "cursor"
  ],
  "author": "fadhlirajwaa",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
